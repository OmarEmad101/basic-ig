# - resource -------------------------------------------------------------------

<https://omaremad101.github.io/basic-ig/Patient/ExampleBasicPatient> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ExampleBasicPatient"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "https://omaremad101.github.io/basic-ig/StructureDefinition/BasicPatient"^^xsd:anyURI ;
       fhir:l <https://omaremad101.github.io/basic-ig/StructureDefinition/BasicPatient>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient ExampleBasicPatient</b></p><a name=\"ExampleBasicPatient\"> </a><a name=\"hcExampleBasicPatient\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-BasicPatient.html\">BasicPatient</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Omar Abdelbar  (no stated gender), DoB Unknown</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Example extension for patient's favorite color.\"><a href=\"StructureDefinition-FavoriteColor.html\"/></td><td colspan=\"3\">Blue</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "https://omaremad101.github.io/basic-ig/StructureDefinition/FavoriteColor"^^xsd:anyURI ;
       fhir:l <https://omaremad101.github.io/basic-ig/StructureDefinition/FavoriteColor>
     ] ;
     fhir:value [
       a fhir:String ;
       fhir:v "Blue"
     ]
  ] ) ; # 
  fhir:name ( [
     fhir:family [ fhir:v "Abdelbar" ] ;
     fhir:given ( [ fhir:v "Omar" ] )
  ] ) . # 

